		'''
}

SacredNaginata: {
	DisplayName: Gaeborg
	Tooltip: ""
	FunctionText:
		'''
		{$Tooltips.KS} [c/FFD700:<Guardian Angel>]
		- Projects an holy shield that absorbs up to {0} damage. The shield grants {1} defense while active.
		- After the shield is broken, it takes {2} seconds to charge back up.
		- Using a healing potion fully restores the shield's durability and cooldown.
		{$Tooltips.KA} [c/FFD700:<The Judgment>]
		- Summon a sacred magic circle and shoot a bunch of blades.
		'''
}

TrueSacredNaginata: {
	DisplayName: True Gaeborg
	Tooltip: ""
	FunctionText:
		'''
		{$Tooltips.KS} [c/FFD700:<Guardian Archangel>]
		- Projects an holy shield that absorbs up to {0} damage. The shield grants {1} defense while active.
		- After the shield is broken, it takes {2} seconds to charge back up.
		- Using a healing potion fully restores the shield's durability and cooldown.
		{$Tooltips.KA} [c/FFD700:<The Judgment of Trinity>]
		- Summon three magic circles and shoot beams and blades.
		'''
}

TerraKatana: {
	DisplayName: Terra Katana
	Tooltip: ""
	FunctionText:
		'''
		{$Tooltips.KS} [c/00FF00:<Guardian of Terra>]
		- Projects an terra shield that absorbs up to {0} damage. The shield grants {1} defense while active.
		- After the shield is broken, it takes {2} seconds to charge back up.
		- Using a healing potion fully restores the shield's durability and cooldown.
		{$Tooltips.KA} [c/60F860:<Terra Destruction>]
		- Press and hold the Right-click to aim. And press the Left-click to disable auto-aiming on enemies.
		- When released, it teleports and unleashes a continuous barrage of slashes.
		- During the slash, the player takes no damage, and the final slash brings down a bolt of lightning.
		'''
}

