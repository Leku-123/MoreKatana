GrassKatana: {
	DisplayName: Kusanagi
	Tooltip: '''"This legendary Japanese sword is made of grass...?"'''
	FunctionText:
		'''
		Katana Spell [c/00FF00:<Photosynthesis>]
		- Applies the Photosynthesis Buff.
		Katana Arts [c/ADFF2F:<Grass Dance>]
		- Swinging the katana in all directions and firing leaves.
		'''
}

VolcanoKatana: {
	DisplayName: Volcano Katana
	Tooltip: ""
	FunctionText:
		'''
		Katana Spell [c/fd3e03:<Ball of Volcano>]
		- Fire a fireball as an attack.
		Katana Arts [c/fe7902:<Volcanic Cinder>]
		- It fires volcanic projectiles whose number increases based on how long the sword is held aloft.
		'''
}

SacredNaginata: {
	DisplayName: Gaeborg
	Tooltip: ""
	FunctionText:
		'''
		Katana Spell [c/FFD700:<Guardian Angel>]
		- Projects an holy shield that absorbs up to 50 damage. The shield grants 10 defense while active.
		- After the shield is broken, it takes 30 seconds to charge back up.
		- Using a healing potion fully restores the shield's durability and cooldown.
		Katana Arts [c/FFD700:<The Judgment>]
		- Summon a sacred magic circle and shoot a bunch of blades.
		'''
}

TrueSacredNaginata: {
	DisplayName: True Gaeborg
	Tooltip: ""
	FunctionText:
		'''
		Katana Spell [c/FFD700:<Guardian Angel++>]
		- Projects an holy shield that absorbs up to 75 damage. The shield grants 10 defense while active.
		- After the shield is broken, it takes 30 seconds to charge back up
		- Using a healing potion fully restores the shield's durability and cooldown.
		Katana Arts [c/FFD700:<The Judgment of Trinity>]
		- Summon three magic circles and shoot beams and blades.
		'''
}

