# -------- Weapons --------
Katana: {
	Tooltip: '''"This weapon requires skill to handle."'''
	FunctionText:
		'''
		{$Tooltips.PS} [c/FFD700:<Technical Tactics>]
		- Change normal attacks to charged attacks
		- A fully charged attack has the power to deflect enemy projectiles. But it has no effect on the boss
		{$Tooltips.AS} [c/FFFFFF:<Flash of Lightning>]
		- Perform a dash slash. It chains to up to 6 enemies
		'''
}

Muramasa: {
	Tooltip: '''"Make the curse your ally!"'''
	FunctionText:
		'''
		{$Tooltips.PS} [c/0000FA:<Revengeance>]
		- When damaged, the ghost will counterattack
		{$Tooltips.AS} [c/0000CD:<Bloodthirsty Ghost>]
		- Summon a ghost for 10 seconds
		- When the player attacks, the ghost will perform an additional attack
		'''
}

