# -------- Weapons --------
Katana: {
	Tooltip: 「実に使用者の技量を問われるカタナだ」
	FunctionText:
		'''
		{$Tooltips.PS} [c/FFD700:<テクニカル戦法>]
		- 通常攻撃が溜め攻撃に変化する
		- 最大まで溜めた攻撃は、敵の発射物を弾き返す (ボスには無効)
		{$Tooltips.AS} [c/FFFFFF:<一閃>]
		- 最大6体の敵に連鎖するダッシュ斬りを行う
		'''
}

Muramasa: {
	Tooltip: 「呪いさえも味方につけろ！」
	FunctionText:
		'''
		{$Tooltips.PS} [c/0000FA:<怨念返し>]
		- 被弾時、カタナに宿る霊が反撃する
		{$Tooltips.AS} [c/0000CD:<血に飢えた亡霊>]
		- 10秒間亡霊を召喚する
		- 亡霊はプレイヤーの攻撃に合わせ追撃を加える
		'''
}

